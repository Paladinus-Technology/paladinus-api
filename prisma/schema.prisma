generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
     provider = "sqlite"
     url      = env("DATABASE_URL")
   }

model Company {
  id        String   @id @unique @default(uuid())
  name      String
  cnpj      String   @unique
  location  String
  emails    CompanyEmail[]
  createdAt DateTime @default(now())
  tickets   Ticket[]
  users     User[]
}
model CompanyEmail {
  id        String  @id @default(uuid())
  email     String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @unique @default(uuid()) 
  name         String
  email        String   @unique
  password     String
  role         UserRole
  companyId    String   
  refreshToken String?
  createdAt    DateTime @default(now())
  Ticket       Ticket[]
  company      Company  @relation(fields: [companyId], references: [id])
}

model Ticket {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  status      TicketStatus @default(ABERTO)
  companyId   String       
  createdById String       
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  solution    String?
  company     Company      @relation(fields: [companyId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])
}

enum UserRole {
  MASTER
  CLIENT
  PROSPECT
}

enum TicketStatus {
  ABERTO
  EM_EXECUCAO
  ESPERANDO_APROVACAO
  ESPERANDO_MATERIAL
  CONCLUIDO
}


model Token{
    email String @id
    token String
}
