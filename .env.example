DATABASE_URL="caminho do arquivo do banco de dados"
PORT=porta de Serviço


#JWT SECRETS
JWT_AUTH_SECRET="SECRET_KEY_HERE"
JWT_AUTH_SECRET_EXPIRATION_TIME=60m
JWT_EXPIRATION_WEEK=7d

JWT_EMAIL_LOGIN="SECRET_KEY_HERE"
JWT_EMAIL_LOGIN_EXPIRATION_TIME=15m

#EMAIL FOR SENDING EMAILS
EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="user@example.com"
EMAIL_PASS="password"
EMAIL_FROM="user@example.com"